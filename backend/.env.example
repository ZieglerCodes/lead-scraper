# Configure using Supabase project URL only. Backend verifies its public JWKS.
# Do not put a Supabase service_role, secret key, or JWT private key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# OPTIONAL: Set DATABASE_URL to a PostgreSQL connection string to use the
# production queue. With no DATABASE_URL, local SQLite behavior is retained.
# Never use real credentials in a Git-tracked .env file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
